# Firebase cloud sync (optional).
# Create a Firebase project at https://console.firebase.google.com,
# add a Web app, enable Google sign-in (Authentication > Sign-in method)
# and Cloud Firestore, then copy the web app config values here.
# Without these values the app runs local-only (browser storage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" only for local development against the Firebase Emulator Suite
# (firebase emulators:start). Leave empty in production.
VITE_FIREBASE_USE_EMULATOR=
