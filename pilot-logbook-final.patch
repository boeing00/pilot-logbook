+
+/** Millisecond timestamp of the last local modification (0 when unknown). */
+export function loadLogbookUpdatedAt(): number {
+  try {
+    const raw = localStorage.getItem(UPDATED_KEY)
+    const n = raw ? Number(raw) : 0
