+  const removed = inside.filter((f) => !byId.has(flightId(f))).length
+  const flights = [...outside, ...byId.values()].sort((a, b) =>
+    a.date < b.date ? -1 : a.date > b.date ? 1 : 0,
+  )
+  return {
+    book: { pilot: prev?.pilot ?? {}, summary: prev?.summary ?? {}, flights },
+    removed,
+    kept: outside.length,
+  }
